# ForgeAppHelp E2E Test Container
# Robot Framework with Browser library (Playwright-backed)
FROM python:3.12-slim

LABEL maintainer="Buildly Marketplace <marketplace@buildly.io>"
LABEL description="ForgeAppHelp E2E test runner with Robot Framework Browser"

# Install OS dependencies for headless Chromium/Playwright
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Playwright dependencies
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libdbus-1-3 \
    libxkbcommon0 \
    libatspi2.0-0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libasound2 \
    libpango-1.0-0 \
    libcairo2 \
    # Additional utilities
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /work

# Copy requirements and install Python dependencies
COPY tests/robot/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Install the Playwright browser binaries.
#
# NOT `rfbrowser init`: that builds the library's Node wrapper and shells out
# to npm, which this image does not have. robotframework-browser-batteries
# exists precisely to avoid that -- it ships a prebuilt grpc_server binary, and
# Browser skips the Node check entirely when it is installed. `install` fetches
# only the browser binaries, which is all that is still missing.
RUN rfbrowser install chromium

# Set up working directory structure
RUN mkdir -p /work/artifacts /work/marketplace/screenshots

# Default environment
ENV BASE_URL=http://app:8000
ENV ROBOT_OUTPUT=/work/artifacts

# Default command runs smoke tests
CMD ["robot", "--outputdir", "/work/artifacts", "/work/tests/robot/smoke.robot"]

# ForgeAppHelp .gitignore

# Node
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
# dist/ is the compiled library and dist-demo/ the built demo app -- both are
# generated by `npm run build` and neither is committed; npm packs dist/ from
# a fresh build via prepublishOnly.
dist/
dist-demo/
build/
out/
.next/
.nuxt/
.svelte-kit/
.angular/
.vite/
*.tsbuildinfo

# Python -- the Robot Framework / Playwright TEST RUNNER only.
# The application itself has no Python dependency.
.venv/
__pycache__/
*.py[cod]

# Forge state files
.forge-port
.forge-node.pid
.forge-node.log

# Buildly / Buster AI-native workflow state
# Volatile machine state is ignored; human-readable docs under
# devdocs/generated/ stay tracked and reviewable.
.buildly/sync/pending/
.buildly/adoption/*.json

# Test artifacts (reports, logs)
# Ignore the contents, not the directory -- git cannot re-include a file whose
# parent directory is excluded, and the .gitkeep files below must stay tracked.
artifacts/*
coverage/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
*.local

# Logs
*.log

# Keep tracked directories
!artifacts/.gitkeep
!marketplace/screenshots/.gitkeep
